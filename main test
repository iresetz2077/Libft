//main memset

int	main(void)
{
	int	*k;

	k = malloc(sizeof(int) * 10);
	if (!k)
		return (1);
	ft_memset(k, 1, 10 * sizeof(int));
	ft_memset(k, 0, 5 * sizeof(int));
	for (int i = 0; i < 10; i++)
		printf("%d ", k[i]);
	free(k);
	return (0);
}

//main bzero

int	main(void)
{
	int	*k;

	k = malloc(sizeof(int) * 10);
	if (!k)
		return (1);
	ft_memset(k, -1, 10 * sizeof(int));
	for (int i = 0; i < 10; i++)
		printf("%d ", k[i]);
	ft_bzero(k, 10 * sizeof(int));
	ft_bzero(k, 5 * sizeof(int));
	for (int i = 0; i < 10; i++)
		printf("%d ", k[i]);
	free(k);
	return (0);
}

//main memcpy

int	main(void)
{
	int	*src;
	int	*dest;

	src = malloc(sizeof(int) * 10);
	if (!src)
		return (1);
	dest = malloc(sizeof(int) * 10);
	if (!dest)
		return (1);
	ft_memset(src, 0, 10 * sizeof(int));
	ft_memset(dest, -1, 10 * sizeof(int));
	ft_memcpy(dest, src, 5 * sizeof(int));
	for (int i = 0; i < 10; i++)
		printf("%d ", dest[i]);
	free(src);
	free(dest);
	return (0);
}

//main memmove
#include <string.h>

int	main(void)
{
	char	a[20] = "0123456789";
	char	b[20] = "0123456789";

	ft_memmove(a + 2, a, 5);
	memmove(b + 2, b, 5);
	printf("src < dest : ft = %s | vrai = %s\n", a, b);
	strcpy(a, "0123456789");
	strcpy(b, "0123456789");
	ft_memmove(a, a + 2, 5);
	memmove(b, b + 2, 5);
	printf("src > dest : ft = %s | vrai = %s\n", a, b);
	return (0);
}

